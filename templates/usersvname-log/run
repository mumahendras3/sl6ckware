#!/bin/execlineb -P

################################################
# Start a logging daemon for the svname daemon #
################################################

s6-envdir env
multisubstitute {
  importas -iu LOGDIR_PERMS LOGDIR_PERMS
  importas -iu CMD CMD
  importas -usCd" " CMD_OPTS CMD_OPTS
  importas -iusCd" " LOG_SCRIPT LOG_SCRIPT
}
importas -iu LOGDIR_PATH LOGDIR_PATH
importas -iu XDG_DATA_HOME XDG_DATA_HOME
if { install -dm $LOGDIR_PERMS $LOGDIR_PATH }
exec -c $CMD $CMD_OPTS -- $LOG_SCRIPT
