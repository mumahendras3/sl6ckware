#!/bin/execlineb -P

#############################################################################
# Start dnscrypt-proxy (a flexible DNS proxy with support for encrypted DNS #
# protocols)                                                                #
#############################################################################

fdmove -c 2 1
s6-envdir env
multisubstitute {
  importas -u CMD CMD
  importas -usCd" " CMD_OPTS CMD_OPTS
}
exec -c $CMD $CMD_OPTS
