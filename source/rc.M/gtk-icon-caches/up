################################################################
# Update/generate icon cache files for system-wide icon themes #
################################################################

# Prepend every output with the service's name
pipeline -w { sed -u "s/^/gtk-icon-caches: /" }
fdmove -c 2 1
elglob dir /usr/share/icons/*
forx -Epo 0 theme_dir { $dir }
ifelse { [ $theme_dir = /usr/share/icons/* ] }
{
  echo "The directory '/usr/share/icons' is empty, skipping..."
}
ifelse { [ -r ${theme_dir}/index.theme ] }
{
  if { echo "Updating icon-theme.cache in ${theme_dir}..." }
  gtk-update-icon-cache -qt $theme_dir
}
# Remove icon-theme.cache from directories that don't appear to be the top-level
# directory of an icon theme
if -t { [ -r ${theme_dir}/icon-theme.cache ] }
if { rm ${theme_dir}/icon-theme.cache }
# Remove $theme_dir if it only contains icon-theme.cache
rmdir -p --ignore-fail-on-non-empty $theme_dir
