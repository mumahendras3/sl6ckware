##############################################################################
# Provide basic compatibility with SystemV style init scripts for runlevel 2 #
##############################################################################

backtick -D"" PREVLEVEL { if { [ -r /run/runlevel ] } cat /run/runlevel }
export RUNLEVEL 2
importas RUNLEVEL RUNLEVEL
if { redirfd -w 1 /run/runlevel echo $RUNLEVEL }
# Run the kill scripts
foreground {
  elglob -s0 scripts /etc/rc.d/rc${RUNLEVEL}.d/K*
  forx -E script { $scripts }
  if { [ -x $script ] }
  # Prepend every output with the service's name
  pipeline -w { sed -u "s/^/sysvinit-rl${RUNLEVEL}: ${script}: /" }
  fdmove -c 2 1
  emptyenv -c $script
}
unexport ?
# Now do the startup scripts
elglob -s0 scripts /etc/rc.d/rc${RUNLEVEL}.d/S*
forx -E script { $scripts }
if { [ -x $script ] }
# Prepend every output with the service's name
pipeline -w { sed -u "s/^/sysvinit-rl${RUNLEVEL}: ${script}: /" }
fdmove -c 2 1
emptyenv -c $script
