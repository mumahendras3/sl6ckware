###########################
# Multiuser mode services #
###########################

# Update all the shared library links
shared-library-links

# Set screen blanking and power management defaults
setterm

# Save the contents of dmesg
save-dmesg

# Start the system logger
syslog

# Update the X font indexes
font-information-caches

# Start the haveged entropy daemon
haveged

# Initialize the networking hardware using either the rc.inet1 script or
# NetworkManager (see bundles/network for more details)
network

# Start D-Bus
messagebus

# Start the session/seat daemon
elogind
#consolekit

# Start Bluetooth
#bluetooth

# Start networking daemons
inet2

# Start the automounter service
#autofs

# Start the Network Time Protocol daemon
#ntpd

# Ensure basic filesystem permissions sanity
ensure-permissions

# Start ACPI daemon
acpid

# Enable CPU frequency scaling
#cpufreq

# Update any existing icon cache files
gtk-icon-caches

# Update mime database
mime-database-cache

# Start system-wide PulseAudio daemon (not recommended and not required in
# order to use PulseAudio - see rc.pulseaudio/pulseaudio-srv for details)
#pulseaudio

# Some GTK+/pango files need to be kept up to date for proper functions
gtk-immodules
gdk-pixbuf-loaders
#pango-querymodules
glib-schemas

# Start dnsmasq (a simple DHCP/DNS server)
#dnsmasq

# Start snmpd
#snmpd

# Start CUPS
#cups

# Start Netatalk AFP server (a file/print server for Macs using Appletalk)
#atalk

# Start smartd (monitors the status of S.M.A.R.T. compatible hard drives and
# reports any problems)
#smartd

# Monitor the UPS with genpowerd (see rc.M/genpowerd-srv first before enabling
# this service)
#genpowerd

# Turn on process accounting
#pacct

# Start crond (Dillon's crond)
crond

# Start atd (manages jobs scheduled with at)
atd

# Start the SASL authentication server (provides SASL authentication services
# for sendmail/postfix)
#saslauthd

# Start the mail server (either sendmail or postfix)
#sendmail <rc script not yet converted>
#postfix

# Load ALSA (sound) defaults
#alsa

# Start the MySQL database
#mysqld

# Start Apache web server
#httpd

# Start OpenLDAP
#openldap

# Start local LDAP name service daemon (from nss-pam-ldapd)
#nss-pam-ldapd

# Start Dovecot
#dovecot

# Start Samba (a file/print server for Win95/NT machines)
#samba

# Start the GPM mouse server
#gpm

# Start the Icecream scheduler (this needs to run on only one machine that is
# part of the compile cluster)
#icecc-scheduler

# Start the Icecream daemon (this needs to run on every machine that will be
# part of the compile cluster - including the machine running the scheduler)
#iceccd

# Start the local setup procedure
local
