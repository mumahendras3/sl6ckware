##################################
# System initialization services #
##################################

# Mount /proc if it is not already mounted
procfs

# Mount /sys if it is not already mounted
sysfs

# Mount a tmpfs on /run (unless the initrd has already done so) and make sure
# that mounts below /run are visible in both /run and /var/run
tmpfs-run

# Initialize udev to manage /dev entries and hotplugging
udev

# Mount Control Groups filesystem interface
cgroupfs

# Initialize the Logical Volume Manager
#lvm

# Open any volumes created by cryptsetup
#luks

# Enable swapping
swap-partitions
#swap-files

# Set the tick and frequency for the system clock
adjtimex

# Set the system time from the hardware clock using hwclock --hctosys
system-time

# Check the root filesystem
fsck-root

# Remount the root filesystem in read-write mode
remount-root

# Update kernel module dependencies and run rc.modules.local
modules

# Configure kernel parameters
sysctl-system

# Check all the non-root filesystems
fsck-all

# Mount non-root local filesystems found in /etc/fstab
local-fs

# Bind mount /run to /var/run
bind-run

# Start libcgroup services
#cgconfig
#cgred

# Clean up some temporary files
cleanup-etc
cleanup-tmp
cleanup-var

# Create /tmp/{.ICE-unix,.X11-unix} if they are not present
ICE-socketdir
X11-socketdir

# Create a fresh utmp file
utmp

# Create pam_faillock(8) tally directory
#faillock

# Update the current kernel level in the /etc/motd (Message Of The Day) file
update-motd

# Run serial port setup script
#serial

# Carry an entropy pool between reboots to improve randomness
random-seed

# Set the hostname (moved from bundles/M)
hostname

# Initialize PCMCIA devices (moved from bundles/M)
#pcmcia

# Load a custom screen font (moved from bundles/M)
#font

# Load a custom keymap (moved from bundles/M)
#keymap
