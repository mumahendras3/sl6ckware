#!/bin/execlineb -P

###################################################
# Start sddm (the simple desktop display manager) #
###################################################

fdmove -c 2 1
emptyenv -p
s6-envdir env
multisubstitute {
  importas -u CMD CMD
  importas -usCd" " CMD_OPTS CMD_OPTS
}
emptyenv -c unexport PATH $CMD $CMD_OPTS
