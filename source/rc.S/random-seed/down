#######################################
# Carry a random seed between reboots #
#######################################

# Prepend every output with the service's name
pipeline -w { sed -u "s/^/random-seed: /" }
fdmove -c 2 1
# Doing this properly requires the seedrng utility
tryexec { seedrng }
# Falling back on the old method when seedrng is not available
if { mkdir -pm700 /var/lib/seedrng }
umask 377
if {
  echo "The SeedRNG utility was not found. Saving a non-creditable and \
inferior RNG seed in /var/lib/seedrng/seed.no-credit..."
}
elglob seeds /var/lib/seedrng/seed.*
backtick -E SEED { pipeline { redirfd -w 2 /dev/null cat $seeds } base64 }
if { rm -f $seeds }
if { sync /var/lib/seedrng }
backtick -D 4096 POOLSIZE {
  redirfd -w 2 /dev/null cat /proc/sys/kernel/random/poolsize
}
backtick -E POOLSIZE { importas -ui POOLSIZE POOLSIZE expr $POOLSIZE / 8 }
pipeline {
  if { head -c $POOLSIZE /dev/urandom }
  pipeline { echo $SEED } base64 -d
}
pipeline { sha512sum }
redirfd -w 1 /var/lib/seedrng/seed.no-credit cut -d" " -f1
