############################################################################
# Trigger udev add events to scan for devices, load the appropriate kernel #
# modules, configure the devices, and populate /dev with device nodes.     #
############################################################################

# Prepend every output with the service's name
pipeline -w { sed -u "s/^/udev-coldplug: /" }
fdmove -c 2 1
if { echo "Triggering udev events: udevadm trigger --action=add" }
# Call udevtrigger and udevsettle to do the device configuration
if { udevadm trigger --type=subsystems --action=add }
if { udevadm trigger --type=devices --action=add }
udevadm settle --timeout=120
