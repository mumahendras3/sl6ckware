############################################################
# Update the hardware database index in /etc/udev/hwdb.bin #
############################################################

# Prepend every output with the service's name
pipeline -w { sed -u "s/^/udev-hwdb: /" }
fdmove -c 2 1
if { echo "Updating hardware database index: udevadm hwdb --update" }
udevadm hwdb --update
