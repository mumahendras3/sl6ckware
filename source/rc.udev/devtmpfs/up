#########################################
# Mount the devtmpfs filesystem on /dev #
#########################################

# Check if the devtmpfs filesystem is already mounted on /dev
backtick -E fstype { stat -fc%T /dev }
if -t { [ $fstype != tmpfs ] } # devtmpfs is considered as tmpfs by stat
# Prepend every output with the service's name
pipeline -w { sed -u "s/^/devtmpfs: /" }
fdmove -c 2 1
mount -vnt devtmpfs -o size=8M devtmpfs /dev
