#!/bin/execlineb -P

#############################################
# Start the BIND name server daemon (named) #
#############################################

fdmove -c 2 1
s6-envdir env
multisubstitute {
  importas -iu NAMED_GROUP NAMED_GROUP
  importas -uD "NO" NAMED_CHOWN NAMED_CHOWN
  importas -iu CMD CMD
  importas -usCd" " CMD_OPTS CMD_OPTS
}
importas -iu NAMED_USER NAMED_USER
# Make sure that /var/run/named exists and has correct ownership
if { install -do $NAMED_USER -g $NAMED_GROUP /var/run/named }
if {
  if -t { [ $NAMED_CHOWN = YES ] }
  # Make sure that /var/named has correct ownership
  chown -R ${NAMED_USER}:${NAMED_GROUP} /var/named
}
ifelse { [ -r /etc/rndc.conf ] }
{
  s6-notifyoncheck -dn0
  exec -c $CMD $CMD_OPTS
}
ifelse { [ -r /etc/rndc.key ] }
{
  if {
    if -t { [ $NAMED_CHOWN = YES ] }
    # Make sure that /etc/rndc.key has correct ownership
    chown ${NAMED_USER}:${NAMED_GROUP} /etc/rndc.key
  }
  s6-notifyoncheck -dn0
  exec -c $CMD $CMD_OPTS
}
# We can't use rndc to poll the named server readiness so we'll announce
# this service's readiness after some fixed period of time
background -d {
  if { sleep 5 }
  fdmove 1 3
  echo
}
unexport ! fdclose 3
exec -c $CMD $CMD_OPTS
